# MongoDB Atlas. MONGO_URI is also supported for an existing configuration.
MONGODB_URI=
MONGODB_DB=portfolio

# Generate a random secret with openssl rand -hex 32.
AUTH_SECRET=
# Set this to your HTTPS origin in production.
AUTH_URL=
# Required for absolute Open Graph image URLs in production.
PUBLIC_SITE_URL=

# Administrator setup only. Remove both values after provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary. CLOUDINARY_URL can be used instead of these three fields.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GROQ_API_KEY=
GROQ_DAILY_LIMIT=60

# Mario Spotlight Mode
MARIO_SPOTLIGHT_HOURS=72
MARIO_SPOTLIGHT_FRESH_HOURS=24
MARIO_SPOTLIGHT_VISIT_MIN_SECONDS=20
MARIO_SPOTLIGHT_VISIT_MAX_SECONDS=35
MARIO_SPOTLIGHT_POLL_SECONDS=45
